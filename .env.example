# Example development env vars

# --- Contact / spam protection ---
# Public Cloudflare Turnstile site key used by the client (ContactDialog.tsx)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret Turnstile key used server-side in the contact API route
TURNSTILE_SECRET_KEY=
# Formspree form ID used to build the contact endpoint
NEXT_PUBLIC_FORMSPREE_KEY=

# --- Found luggage page notifications (/found-luggage, redirected from /lost-luggage) ---
# Telegram bot token, from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram chat ID to send the alert to
TELEGRAM_CHAT_ID=

# --- Sentry error tracking ---
# Secret DSN for Sentry (server + edge SDK)
# Obtain from: Sentry Project Settings > Client Keys (DSN)
SENTRY_DSN=
# Public Sentry DSN for browser SDK
# Obtain from: Sentry Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Environment label shown in Sentry (e.g. development | preview | production)
SENTRY_ENVIRONMENT=development
# Auth token for uploading source maps to Sentry
# Obtain from: Sentry Settings > User Settings (click avatar → Settings) > Auth Tokens > Create New Token
# Required scopes: project:releases, project:write
SENTRY_AUTH_TOKEN=
# Organization slug from Sentry
# Obtain from: Sentry Settings > Organization Settings > General Settings > Organization Slug
SENTRY_ORG=
# Project slug from Sentry
# Obtain from: Sentry Project Settings > General Settings > Project Slug
SENTRY_PROJECT=
# Sample rate for performance traces (0.0 to 1.0)
# Default is 0.1 (10% of transactions) if not set
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Cache-busting versions (bump when you update assets) ---
NEXT_PUBLIC_PDF_CACHE_DATE=
NEXT_PUBLIC_OG_CACHE_DATE=
NEXT_PUBLIC_ICONS_CACHE_DATE=
NEXT_PUBLIC_IMAGES_CACHE_DATE=

# --- DeepL Translation API ---
# Get your API key at https://www.deepl.com/pro-api
# Required for running `pnpm translate` to generate Spanish translations
DEEPL_API_KEY=
