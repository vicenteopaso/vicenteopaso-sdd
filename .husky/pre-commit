#!/usr/bin/env sh

# Extend PATH for GUI clients (e.g. GitHub Desktop) that use a limited shell.
# Append rather than prepend so the caller's Node (e.g. nvm, matching .nvmrc)
# wins over a Homebrew one; pnpm's engineStrict rejects other majors.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

# Husky sets a repo-local core.hooksPath, which shadows any global hooks
# directory. Chain a global pre-commit (e.g. a personal secret-scan safety
# net) so installing Husky never silently disables it.
global_hooks=$(git config --global --get core.hooksPath 2>/dev/null)
if [ -n "$global_hooks" ]; then
  case "$global_hooks" in
    "~"/*) global_hooks="$HOME/${global_hooks#\~/}" ;;
  esac
  global_hook="$global_hooks/pre-commit"
  if [ -x "$global_hook" ]; then
    "$global_hook" || exit $?
  fi
fi

# Run lint-staged using the repo-pinned pnpm version when possible.
# Prefer Corepack (which enforces the pnpm version from package.json),
# but fall back to plain pnpm in environments where the `corepack` CLI
# is not available (e.g. some GUI Git clients).
if command -v corepack >/dev/null 2>&1; then
  corepack pnpm lint-staged
else
  pnpm lint-staged
fi
